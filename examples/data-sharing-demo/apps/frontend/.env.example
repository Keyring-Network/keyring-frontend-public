# Keyring Configuration
NEXT_PUBLIC_KEYRING_API_KEY=your_api_key_here

# Environment: production, sandbox, or development
NEXT_PUBLIC_KEYRING_ENV=development

# Keyring API base URL used by SDK
NEXT_PUBLIC_BACKEND_URL=https://sandbox-titan.api.keyring-backend.krndev.net

# Local backend API for session tracking
NEXT_PUBLIC_APP_API_URL=http://localhost:8000