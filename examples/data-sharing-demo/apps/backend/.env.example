# Server Configuration
PORT=8001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Keyring Configuration
# Get this from your Keyring partner onboarding
KEYRING_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: For proxying requests to Keyring API
KEYRING_API_KEY=your_api_key_here

# Keyring API URL
KEYRING_API_URL=http://localhost:8000